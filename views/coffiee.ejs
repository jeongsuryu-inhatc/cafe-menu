<%- include('header', { category, categories, activeCategory: 'coffee' }) %>

<main id="top">
  <section class="category-hero">
    <p class="eyebrow">01 / <%= category.label.toUpperCase() %></p>
    <h1>깊고 따뜻한<br /><em>커피 한 잔.</em></h1>
    <p class="hero-description"><%= category.description %></p>
  </section>

  <section class="menu-sections category-menu">
    <div class="section-heading">
      <div><p class="section-number">01</p><h2><%= category.title %> <span><%= category.label %></span></h2></div>
      <p class="section-description">오늘의 기분에 맞는 커피를 골라보세요.</p>
    </div>
    <div class="menu-grid">
      <% category.items.forEach((item) => { %>
        <article class="menu-card">
          <div class="card-image-wrap"><img class="card-image" src="<%= item.image %>" alt="<%= item.name %>" loading="lazy" /><% if (item.tag) { %><span class="card-tag"><%= item.tag %></span><% } %></div>
          <div class="card-content"><div class="card-title-row"><div><h3><%= item.name %></h3><p><%= item.english %></p></div><strong><%= item.price.toLocaleString('ko-KR') %><small>원</small></strong></div><p class="card-description"><%= item.description %></p></div>
        </article>
      <% }) %>
    </div>
  </section>
</main>

<%- include('footer') %>
